# ---------------------------------------------------------------------------
# UniOS AI — example environment file. Copy to .env and fill in real values.
# Never commit .env. Never expose non NEXT_PUBLIC_* values to the frontend.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
APP_NAME=UniOS AI
ENVIRONMENT=development           # development | staging | production
API_PORT=8000
WEB_PORT=3000

# --- Database --------------------------------------------------------------
POSTGRES_USER=unios
POSTGRES_PASSWORD=change-me
POSTGRES_DB=unios
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://unios:change-me@localhost:5432/unios

# --- Cache -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Auth ------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:3000

# --- Frontend --------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=UniOS AI

# --- AI providers (Phase 2) ------------------------------------------------
# Provider-agnostic: any OpenAI-compatible endpoint works. Examples —
#   OpenAI       AI_BASE_URL=https://api.openai.com/v1
#   OpenRouter   AI_BASE_URL=https://openrouter.ai/api/v1
#   Groq         AI_BASE_URL=https://api.groq.com/openai/v1
#   Ollama       AI_BASE_URL=http://localhost:11434/v1  AI_ALLOW_KEYLESS=true
#   vLLM         AI_BASE_URL=http://localhost:8001/v1   AI_ALLOW_KEYLESS=true
AI_PROVIDER=openai_compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_ALLOW_KEYLESS=false
AI_TEMPERATURE=0.3
AI_MAX_OUTPUT_TOKENS=1200
CHAT_HISTORY_LIMIT=20

# --- Models for later phases ------------------------------------------------
EMBEDDING_MODEL=
RERANKER_MODEL=
VISION_MODEL=
SPEECH_TO_TEXT_MODEL=
TEXT_TO_SPEECH_MODEL=

# --- Vector store (Phase 3) ------------------------------------------------
VECTOR_BACKEND=pgvector           # pgvector | qdrant | weaviate
QDRANT_URL=

# --- Storage / uploads -----------------------------------------------------
UPLOAD_DIR=./var/uploads
MAX_UPLOAD_MB=25
