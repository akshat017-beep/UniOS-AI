# ---------------------------------------------------------------------------
# UniOS AI — example environment file. Copy to .env and fill in real values.
# Never commit .env. Never expose non NEXT_PUBLIC_* values to the frontend.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
APP_NAME=UniOS AI
ENVIRONMENT=development           # development | staging | production
API_PORT=8000
WEB_PORT=3000

# --- Database --------------------------------------------------------------
POSTGRES_USER=unios
POSTGRES_PASSWORD=change-me
POSTGRES_DB=unios
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://unios:change-me@localhost:5432/unios

# --- Cache -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Auth ------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:3000

# --- Frontend --------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=UniOS AI

# --- AI providers (Phase 2) ------------------------------------------------
# Provider-agnostic: any OpenAI-compatible endpoint works. Examples —
#   OpenAI       AI_BASE_URL=https://api.openai.com/v1
#   OpenRouter   AI_BASE_URL=https://openrouter.ai/api/v1
#   Groq         AI_BASE_URL=https://api.groq.com/openai/v1
#   Ollama       AI_BASE_URL=http://localhost:11434/v1  AI_ALLOW_KEYLESS=true
#   vLLM         AI_BASE_URL=http://localhost:8001/v1   AI_ALLOW_KEYLESS=true
AI_PROVIDER=openai_compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_ALLOW_KEYLESS=false
AI_TEMPERATURE=0.3
AI_MAX_OUTPUT_TOKENS=1200
CHAT_HISTORY_LIMIT=20

# --- Multimodal (optional, Phase 5) -----------------------------------------
# Leave empty to disable. When empty the API returns 503 with this variable
# name instead of inventing an answer.
AI_VISION_MODEL=
AI_TRANSCRIPTION_MODEL=

# --- Embeddings (Phase 3) ---------------------------------------------------
# May point at a different endpoint than the chat model. Set EMBEDDING_PROVIDER
# to "hashing" only for local development — it is deterministic but far weaker.
EMBEDDING_PROVIDER=openai_compatible   # openai_compatible | hashing
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64

# --- Retrieval / vector store (Phase 3) -------------------------------------
VECTOR_BACKEND=pgvector           # pgvector | portable
CHUNK_SIZE_WORDS=220
CHUNK_OVERLAP_WORDS=40
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.05

# --- Storage / uploads -----------------------------------------------------
UPLOAD_DIR=./var/uploads
MAX_UPLOAD_MB=20

# --- Rate limiting (Phase 7) ------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
AI_RATE_LIMIT_REQUESTS=20
AI_RATE_LIMIT_WINDOW_SECONDS=60

# --- Sandboxed code execution (Phase 4) -------------------------------------
# Runs as a subprocess with a timeout and memory cap. For untrusted multi-tenant
# use, run the API inside a container with no network and a read-only filesystem.
CODE_EXECUTION_ENABLED=true
CODE_EXECUTION_TIMEOUT_SECONDS=8
CODE_EXECUTION_MAX_OUTPUT_CHARS=20000
CODE_EXECUTION_MEMORY_MB=256
